# "lariat dark": the bundled default theme. Muted greens and earth tones on a
# near-black, green-tinted base. Keys are documented in schema.md; any attrset
# with the same keys works as services.lariat.theme.palette (extra keys and
# non-string values are ignored).
{
  # Backgrounds, darkest first
  crust = "111412";
  mantle = "161a17"; # app chrome
  base = "1c211d"; # terminal background
  surface0 = "232924";
  surface1 = "2d342e";
  surface2 = "3b443c";
  overlay0 = "515b52";
  overlay1 = "68736a";

  # Text, brightest first
  text = "d9dece";
  bright = "f2f4ea";
  subtext = "c2c9b8";
  muted = "9ba495";
  faint = "7d867a";

  red = "e8775f";
  green = "a6c47c";
  yellow = "e4c46e";
  blue = "82abc9";
  purple = "c49dc9";
  aqua = "7ec4a8";
  orange = "e89c5c";

  # Darker twins for ANSI 0-7
  redDim = "bb5a48";
  greenDim = "7f9b5c";
  yellowDim = "b99b51";
  blueDim = "5f88a7";
  purpleDim = "9c79a2";
  aquaDim = "5c9c85";
  orangeDim = "b97a44";

  accent = "a6c47c"; # green
  accent2 = "82abc9"; # blue
}
